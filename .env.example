# Backend / edge environment variables
# Copy to .env (gitignored) — never commit real secrets.

# --- Database ---------------------------------------------------------------
# Local dev: leave unset. The app picks ./parkwise.db, falling back to
# /tmp/parkwise.db when the repo dir is not writable (e.g. serverless).
PARKWISE_DB_PATH=

# Deployment: hosted Postgres (Neon, Supabase, RDS…). One env var switches
# the whole app from SQLite to Postgres — no code changes.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Security ---------------------------------------------------------------
# JWT signing secret. REQUIRED in deployment (set in Vercel project env).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# --- API / frontend ---------------------------------------------------------
# Backend CORS origins (comma separated). Vite dev server runs on 5310.
PARKWISE_CORS_ORIGINS=http://localhost:5310,http://127.0.0.1:5310

# Frontend: API base URL. Leave empty in dev (Vite proxies /api to :8010).
# For a deployed frontend pointing at a different API host, set the full URL.
VITE_API_BASE_URL=

# --- Edge agent (laptop only — never on the server) -------------------------
# See edge_agent/requirements.txt; run with its own flags:
#   python edge_agent/webcam_agent.py --api http://127.0.0.1:8010 \
#       --calibration edge_agent/calibration.json --camera 0
# Device API keys come from the seed (sim-key-lot-a/b/c) or your own devices
# table; pass per run with --api-key or PARKWISE_DEVICE_KEY for mock_device.
PARKWISE_DEVICE_KEY=sim-key-lot-a

# --- Scripts ----------------------------------------------------------------
# scripts/smoke_test.py and scripts/mock_device.py default to local:
PARKWISE_BASE_URL=http://127.0.0.1:8010
